# Haier U+ (Europe) account credentials for haier_key_refresh.py
# Copy this to a real .env / docker-compose environment and fill in real values.

# App-level credentials (same for every install of the Good Air / Haier U+ app,
# NOT per-user secrets). Extract them from the APK if you don't have them.
HAISMART_APP_ID=MB-HKQHWBB-0001
HAISMART_APP_KEY=c403cbfc780dd8a0ab68784bb6d3023b

# Your Haier account used with the hOn / Haier U+ Europe app (country Russia).
HAISMART_USERNAME=you@example.com
HAISMART_PASSWORD=__CHANGE_ME__

# AC device ID (its MAC without colons, shown by haier_euro_keys.py).
# Or pass --device-id on the command line instead.
HAISMART_DEVICE_ID=XXXXXXXXXXXX

# HA paths (defaults shown). HA_STORAGE is inside the homeassistant container.
HA_STORAGE=/config/.storage/core.config_entries
HA_URL=http://localhost:8123

# HA refresh token (prefix "refresh:") or long-lived access token. Needed to
# restart HA when the key changes; without it the script only patches the file
# (status=patched_no_restart).
HA_TOKEN=refresh:__PASTE_REFRESH_TOKEN_HERE__

# OAuth client_id bound to a "normal"-type refresh token (required to mint an
# access token from it). Not needed for a long-lived access token.
# Example: HA_CLIENT_ID=https://ha.pi.lan/
HA_CLIENT_ID=